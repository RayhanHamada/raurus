{
    "name": "@raurus/server",
    "version": "0.0.0",
    "description": "A starter for creating a TypeScript package.",
    "homepage": "https://github.com/RayhanHamada/raurus#readme",
    "bugs": {
        "url": "https://github.com/RayhanHamada/raurus/issues"
    },
    "license": "MIT",
    "author": "Muhammad Rayhan Hamada Budiman <rayhanhamada1999@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RayhanHamada/raurus.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        ".": "./dist/index.mjs",
        "./core": "./dist/core/index.mjs",
        "./runtime": "./dist/runtime/index.mjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown --config-loader unrun",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "release": "bumpp"
    },
    "dependencies": {
        "@raurus/logger": "workspace:*",
        "elysia": "^1.4.29",
        "s3mini": "^0.9.5",
        "ts-pattern": "^5.9.0"
    },
    "devDependencies": {
        "@raurus/tsconfig": "workspace:*",
        "@types/node": "^26.1.1",
        "bumpp": "^11.1.0",
        "tsdown": "^0.22.7",
        "typescript": "^7.0.2",
        "unrun": "^0.3.1",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@cloudflare/workers-types": "latest",
        "@libsql/client": "^0.17.4"
    }
}
